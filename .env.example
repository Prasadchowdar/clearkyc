# Copy this file to .env and fill in real values. .env is gitignored — never
# commit it. This template is PUBLIC, so it must only ever contain placeholders.

# --- Database (Docker Compose injects its own; set this for local non-Docker runs) ---
DATABASE_URL=postgresql+psycopg://clearkyc:clearkyc@localhost:5432/clearkyc

# --- Providers ---
# Defaults are free/offline/deterministic, so a fresh clone runs with NO key.
# Switch any of these to the real OpenAI path by setting it to "openai"/"openai"/"openai".
EXTRACTOR=mock      # mock | openai   (document field extraction via vision)
EMBEDDER=mock       # mock | openai   (rule/query embeddings for RAG)
REASONER=rules      # rules | openai  (decision reasoning)

# --- OpenAI (only needed if any provider above is set to "openai") ---
# Put your OWN key here in your local .env. Do NOT paste a real key into this
# example file — it is committed to git and would be exposed publicly.
OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_OWN_KEY
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
